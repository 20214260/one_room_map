{
  "openapi": "3.1.0",
  "info": {
    "title": "Sunroom frontend integration contract",
    "version": "1.0.0",
    "description": "Proposed FastAPI contract. See API_CONTRACT.md for session, CSRF, null and AI validation rules. No backend implementation is included."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/rooms": {
      "get": {
        "operationId": "get_rooms",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Search"
                }
              }
            }
          }
        ]
      }
    },
    "/rooms/{id}": {
      "get": {
        "operationId": "get_rooms_id",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/csrf": {
      "get": {
        "operationId": "get_auth_csrf",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": ["token"]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "get_auth_me",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "post_auth_login",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 72
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "post_auth_register",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72,
                    "pattern": "^(?=.*[A-Za-z])(?=.*[0-9]).+$"
                  },
                  "agreed": {
                    "const": true
                  },
                  "termsVersion": {
                    "type": "string"
                  }
                },
                "required": ["email", "password", "agreed", "termsVersion"]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "post_auth_logout",
        "responses": {
          "204": {
            "description": "Success"
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/oauth/{provider}/start": {
      "post": {
        "operationId": "post_auth_oauth_provider_start",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authorizationUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["authorizationUrl"]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "returnTo": {
                    "type": "string"
                  }
                },
                "required": ["returnTo"]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "enum": ["kakao", "google"]
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/recommendations": {
      "post": {
        "operationId": "post_recommendations",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendation"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Source": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "collectedAt": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "kind": {
            "enum": ["sample", "licensed", "public"]
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["name", "url", "collectedAt", "license", "kind", "note"]
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "title": {
            "type": "string"
          },
          "neighborhood": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "coordinates": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": ["lat", "lng"]
              },
              {
                "type": "null"
              }
            ]
          },
          "deposit": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "rent": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "maintenance": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "area": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "floor": {
            "type": ["integer", "null"]
          },
          "options": {
            "type": "object",
            "properties": {
              "aircon": {
                "type": ["boolean", "null"]
              },
              "washer": {
                "type": ["boolean", "null"]
              },
              "fridge": {
                "type": ["boolean", "null"]
              },
              "induction": {
                "type": ["boolean", "null"]
              },
              "desk": {
                "type": ["boolean", "null"]
              },
              "closet": {
                "type": ["boolean", "null"]
              },
              "elevator": {
                "type": ["boolean", "null"]
              }
            },
            "additionalProperties": false
          },
          "nearCommercial": {
            "type": ["boolean", "null"]
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                }
              },
              "required": ["url", "alt"]
            }
          },
          "schoolDistance": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "facilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": ["convenience", "market", "bus"]
                },
                "name": {
                  "type": "string"
                },
                "distance": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              },
              "required": ["type", "name", "distance"]
            }
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "distanceSource": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "neighborhood",
          "description",
          "coordinates",
          "deposit",
          "rent",
          "maintenance",
          "area",
          "floor",
          "options",
          "nearCommercial",
          "photos",
          "schoolDistance",
          "facilities",
          "source",
          "distanceSource",
          "published"
        ]
      },
      "Filters": {
        "type": "object",
        "properties": {
          "maxRent": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "maxMaintenance": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "maxDeposit": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "nearCommercial": {
            "type": ["boolean", "null"]
          },
          "options": {
            "type": "array",
            "items": {
              "enum": ["aircon", "washer", "fridge", "induction", "desk", "closet", "elevator"]
            }
          },
          "facilities": {
            "type": "array",
            "items": {
              "enum": ["convenience", "market", "bus"]
            }
          }
        },
        "required": [
          "maxRent",
          "maxMaintenance",
          "maxDeposit",
          "nearCommercial",
          "options",
          "facilities"
        ]
      },
      "Search": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "sort": {
            "enum": ["match", "monthly", "deposit", "distance", "area"]
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "bounds": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "south": {
                    "type": "number"
                  },
                  "north": {
                    "type": "number"
                  },
                  "west": {
                    "type": "number"
                  },
                  "east": {
                    "type": "number"
                  }
                },
                "required": ["south", "north", "west", "east"]
              },
              {
                "type": "null"
              }
            ]
          },
          "onlyMatches": {
            "type": "boolean"
          }
        },
        "required": ["query", "sort", "filters", "bounds", "onlyMatches"]
      },
      "RoomsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Room"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["items", "total"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "provider": {
            "enum": ["email", "kakao", "google"]
          }
        },
        "required": ["id", "name", "email", "provider"]
      },
      "RecommendationRequest": {
        "type": "object",
        "properties": {
          "roomIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "prompt": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["roomIds", "filters", "prompt"]
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": ["ai", "rules"]
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "roomId": {
                  "type": "string"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "enum": [
                          "rent",
                          "maintenance",
                          "deposit",
                          "monthly",
                          "area",
                          "floor",
                          "schoolDistance",
                          "options",
                          "facilities"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": ["field", "text"]
                  }
                },
                "tradeoffs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "enum": [
                          "rent",
                          "maintenance",
                          "deposit",
                          "monthly",
                          "area",
                          "floor",
                          "schoolDistance",
                          "options",
                          "facilities"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": ["field", "text"]
                  }
                }
              },
              "required": ["roomId", "reasons", "tradeoffs"]
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallbackReason": {
            "type": ["string", "null"]
          }
        },
        "required": ["mode", "summary", "items", "limitations", "fallbackReason"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    }
  }
}
