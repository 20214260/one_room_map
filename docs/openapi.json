      "post": {
        "operationId": "post_owner_photos",
        "description": "Landlord only. Validate and store image, return own public path or HTTPS URL.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
