  "components": {
    "schemas": {
      "Source": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "collectedAt": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "kind": {
            "enum": ["sample", "licensed", "public", "owner"]
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["name", "url", "collectedAt", "license", "kind", "note"]
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "title": {
            "type": "string"
          },
          "neighborhood": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "coordinates": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lng": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                },
                "required": ["lat", "lng"]
              },
              {
                "type": "null"
              }
            ]
          },
          "deposit": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "rent": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "maintenance": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "area": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "floor": {
            "type": ["integer", "null"]
          },
          "options": {
            "type": "object",
            "properties": {
              "aircon": {
                "type": ["boolean", "null"]
              },
              "washer": {
                "type": ["boolean", "null"]
              },
              "fridge": {
                "type": ["boolean", "null"]
              },
              "induction": {
                "type": ["boolean", "null"]
              },
              "desk": {
                "type": ["boolean", "null"]
              },
              "closet": {
                "type": ["boolean", "null"]
              },
              "elevator": {
                "type": ["boolean", "null"]
              }
            },
            "additionalProperties": false
          },
          "nearCommercial": {
            "type": ["boolean", "null"]
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                }
              },
              "required": ["url", "alt"]
            }
          },
          "schoolDistance": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "facilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": ["convenience", "market", "bus"]
                },
                "name": {
                  "type": "string"
                },
                "distance": {
                  "type": ["number", "null"],
                  "minimum": 0
                }
              },
              "required": ["type", "name", "distance"]
            }
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "distanceSource": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "published": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "neighborhood",
          "description",
          "coordinates",
          "deposit",
          "rent",
          "maintenance",
          "area",
          "floor",
          "options",
          "nearCommercial",
          "photos",
          "schoolDistance",
