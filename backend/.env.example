# 이 파일을 .env 로 복사해서 실제 값 넣기. .env 는 절대 커밋 금지
# Supabase > Connect > Session pooler 연결 문자열 (드라이버 부분을 postgresql+psycopg 로)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<DB비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 쉼표로 여러 개 가능
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 배포에서만 true
COOKIE_SECURE=false
# 등록 즉시 공개(해커톤 시연). 검수 운영 시 false
AUTO_PUBLISH=true
# 사진 업로드 (Supabase > Project Settings > API). service_role 키는 서버 전용 비밀
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_BUCKET=room-photos
