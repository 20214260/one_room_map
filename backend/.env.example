# 이 파일을 .env 로 복사해서 실제 값 넣기. .env 는 절대 커밋 금지
# Supabase > Connect > Session pooler 연결 문자열 (드라이버 부분을 postgresql+psycopg 로)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<DB비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 쉼표로 여러 개 가능
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HTTPS 배포에서만 true
COOKIE_SECURE=false
# 등록 즉시 공개(해커톤 시연). 검수 운영 시 false
AUTO_PUBLISH=true
# 사진 업로드 (Supabase > Project Settings > API). service_role 키는 서버 전용 비밀
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_BUCKET=room-photos
# 소셜 로그인 (카카오/구글). 비어 있으면 해당 버튼은 "준비 중" 오류(503)로 처리됨
# 브라우저가 보는 백엔드 주소. 카카오/구글 콘솔의 Redirect URI = <이 값>/api/v1/auth/oauth/<kakao|google>/callback
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
# 로그인이 끝나면 돌려보낼 프론트 주소
FRONTEND_URL=http://127.0.0.1:5173
# 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > REST API 키. Client Secret 을 '사용함'으로 켰을 때만 SECRET 도 입력
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 집주인 인증 심사 관리자 (쉼표로 여러 명). 이 이메일로 로그인한 계정만 /admin/verifications 사용 가능
ADMIN_EMAILS=
# 인증 증빙 보관. SUPABASE_SERVICE_ROLE_KEY 가 있으면 이 버킷(반드시 Private)에, 없으면 PROOF_DIR 폴더에 저장
PROOF_BUCKET=owner-proofs
# PROOF_DIR=  (기본 backend/.private/proofs. 웹으로 제공되는 폴더 안에 두지 말 것)
