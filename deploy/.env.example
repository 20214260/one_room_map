# 서버 접속·배포 설정 (강사 샘플과 같은 형식). 실제 값은 deploy/.env 에만, 절대 커밋 금지
USER_ID=a0
PASSWORD=
HOST=app.scnuoss.net
DEPLOY_ADDRESS=https://a0.scnuoss.net/
WORK_PATH=/home/a0/html/
# 앱 코드·가상환경·비밀 설정 위치 (반드시 WORK_PATH 밖. WORK_PATH 는 nginx 가 그대로 공개함)
APP_PATH=/home/a0/sunroom/
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=3100
# 비밀번호 대신 쓸 SSH 키 (scripts/deploy.sh). 처음 한 번 서버에 등록 필요 (README 배포 참고)
SSH_KEY=~/.ssh/sunroom_a7
